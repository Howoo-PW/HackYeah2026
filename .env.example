# Skopiuj do .env i uzupełnij. .env jest w .gitignore — nigdy go nie commituj.
# Lista zgodna z IMPLEMENTATION_PLAN.md (sekcja 5) i docs/CONTRACT.md (sekcja 8).

# wspólne
APP_ENV=dev

# Supabase (projekt HackYeah2026)
SUPABASE_URL=https://lsfpirkqdtjkcaujnsde.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# backend
CORS_ORIGINS=http://localhost:5173
AI_SERVICE_URL=http://localhost:8001
INTERNAL_API_KEY=
REDIS_URL=redis://localhost:16379/0
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# ai-service
AI_PROVIDER=google_genai
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# OpenAI: AI_PROVIDER=openai, AI_MODEL=gpt-5.4-nano, AI_REASONING_EFFORT=none (AI_BASE_URL puste)
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1, AI_STRUCTURED_METHOD=json_mode, AI_REASONING_EFFORT=low
AI_STRUCTURED_METHOD=
AI_REASONING_EFFORT=
MOCK_AI=true

# frontend (publiczne — trafiają do przeglądarki, bez sekretów)
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://lsfpirkqdtjkcaujnsde.supabase.co
VITE_SUPABASE_ANON_KEY=
